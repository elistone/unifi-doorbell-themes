# Protect connection. The API key is created at:
#   Protect -> Settings -> Control Plane -> Integrations
PROTECT_HOST=192.168.1.1
PROTECT_API_KEY=

# The FIRST doorbell, adopted on first run so a headless install works
# without opening the UI. After that, doorbells live in the database and are
# added, named and removed from Settings - this is only read when there are
# none at all, so it cannot resurrect one you deliberately removed.
#
# Taken explicitly rather than discovered because the public API does not
# expose hasLcdScreen and model-name matching is unreliable. `probe` prints
# the id of every camera that can display an image.
PROTECT_CAMERA_ID=

# Optional. Fires on apply-success, apply-failure, and scheduler-stalled.
# A plain URL covers Uptime Kuma, ntfy, Discord, Slack, Gotify and Home
# Assistant without a provider list to maintain.
NOTIFY_URL=
NOTIFY_METHOD=POST

# Required for SOUND, and for deleting anything.
#
# Images need only the API key above. Changing what the visitor hears uses
# Protect's private API, which wants a real UniFi OS account rather than a
# read-scoped key. Leave these blank for an images-only setup - everything
# still works, you just cannot change the ring sound.
PROTECT_ADMIN_USER=
PROTECT_ADMIN_PASS=

# --- The web UI ---------------------------------------------------------
# There is no account configured here. The first time you open the UI it
# asks you to create one, and a password set in a file is a password that
# ends up in a backup, a git history and a terminal scrollback.

# Set when something in front of this terminates TLS, so the session cookie
# carries Secure. The app itself only ever speaks plain HTTP, so it cannot
# work this out for itself - and guessing wrong either breaks login (Secure
# over HTTP) or sends the session cookie in the clear.
DOORMAN_SECURE_COOKIES=false
